APP_NAME="Vehicle Registration API"
APP_ENV=local
APP_KEY=b4c1a581d57adc9bb963755e3d6e75cde5eea0e1e118787932a6a8ad0b96be07
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
